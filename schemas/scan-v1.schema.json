{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dev Environment Auditor scan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "scan",
    "projects",
    "installed_resources",
    "relations",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "scan": {
      "$ref": "#/$defs/scan"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "installed_resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/installedResource"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at", "roots", "exclusions", "read_only"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "exclusions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "read_only": {"const": true}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "kind", "requirements", "warnings"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["FLUTTER", "ANDROID", "FLUTTER_ANDROID", "DOCKER"]},
        "last_modified_at": {"type": "string", "format": "date-time"},
        "requirements": {
          "type": "array",
          "items": {"$ref": "#/$defs/requirement"}
        },
        "warnings": {"$ref": "#/$defs/stringArray"}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ecosystem", "component", "confidence", "evidence", "warnings"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "ecosystem": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "version_constraint": {"type": "string"},
        "confidence": {"enum": ["REQUIRED_EXPLICITLY", "PROBABLY_REQUIRED", "UNKNOWN"]},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "warnings": {"$ref": "#/$defs/stringArray"}
      }
    },
    "installedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ecosystem", "component", "path", "reference_status", "metadata", "warnings"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "ecosystem": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "reference_status": {"enum": ["REFERENCED", "NO_REFERENCE_FOUND", "UNKNOWN"]},
        "metadata": {
          "type": "array",
          "items": {"$ref": "#/$defs/metadataEntry"}
        },
        "warnings": {"$ref": "#/$defs/stringArray"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "requirement_id", "match_status", "rationale", "evidence", "warnings"],
      "allOf": [
        {
          "if": {
            "properties": {"environment": {"const": "DOCKER"}},
            "required": ["environment"]
          },
          "then": {
            "not": {"required": ["resource_id"]}
          }
        }
      ],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "requirement_id": {"type": "string", "minLength": 1},
        "environment": {"enum": ["HOST", "DOCKER", "DOCKER_DAEMON"]},
        "resource_id": {"type": "string", "minLength": 1},
        "match_status": {"enum": ["MATCHED", "MISSING", "AMBIGUOUS", "UNKNOWN"]},
        "rationale": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "warnings": {"$ref": "#/$defs/stringArray"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "rule_id"],
      "properties": {
        "source_type": {"type": "string", "minLength": 1},
        "file_path": {"type": "string"},
        "key": {"type": "string"},
        "line_hint": {"type": "integer", "minimum": 1},
        "command": {
          "type": "array",
          "items": {"type": "string"}
        },
        "observed_value": {"type": "string"},
        "rule_id": {"type": "string", "minLength": 1}
      }
    },
    "metadataEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "value": {"type": "string"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "scope", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["INFO", "WARNING", "ERROR"]},
        "scope": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "path": {"type": "string"}
      }
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
